#!/bin/bash
#41 06 * * 3 /home/pi/sound/names_in_songs > name`date +\%d-\%m-\%Y-\%T`
#11 14 * * 3 /home/pi/sound/names_in_songs names2.m4a > name`date +\%d-\%m-\%Y-\%T`
#start time is around 6:40am and 14:10
file=${1:-names.m4a}
length=${2:-27\:00}
colin=${3:-pi}
cover=${4:-ak.jpeg}
trixie64=${5:-192.168.0.37}

embed_cover() {
    local audio_file="$1"
    local cover_img="${2:-${HOME}/Pictures/${cover}}"

    if [ ! -f "$audio_file" ]; then
        echo "Error: Audio file not found at $audio_file"
        return 1
    fi

    if [ ! -f "$cover_img" ]; then
        echo "Warning: Cover image not found at $cover_img"
        return 1
    fi

    local ext="${audio_file##*.}"
    local ext_lower="${ext,,}"
    local tmp_cover="${audio_file%.*}.cover.${ext}"
    local extra_flags=()

    if [ "$ext_lower" = "mp3" ]; then
        extra_flags=(-id3v2_version 3)
    elif [ "$ext_lower" != "m4a" ]; then
        echo "Warning: Unsupported audio format .$ext"
        return 1
    fi

    echo "$tmp_cover" "$cover_img"

    if ffmpeg -nostdin -loglevel error -y -i "$audio_file" -i "$cover_img" \
        -map 0:a -map 1:v -c copy "${extra_flags[@]}" \
        -disposition:v:0 attached_pic "$tmp_cover"; then
        mv "$tmp_cover" "$audio_file"
    else
        echo "Warning: Failed to attach cover art from $cover_img"
        rm -f "$tmp_cover"
        return 1
    fi
}


radio6="http://lsn.lv/bbcradio.m3u8?station=bbc_6music&bitrate=320000"
if [ -f /home/$colin/Music/$file ]; then
rm /home/$colin/Music/$file
fi
echo Start $(date)
ffmpeg -to $length -i "$radio6" -c copy -metadata title="$(echo $file | sed 's/\..*//')" -metadata date="$(date +%Y)" /home/$colin/Music/$file
len=$(ls -l /home/$colin/Music/$file | awk '{ print $5 }')
if [ -f /home/$colin/Music/$file ]; then
  echo $len file made /home/$colin/Music/$file
  if [ $len -lt 50000 ]; then 
    echo try again
    rm /home/$colin/Music/$file
    ffmpeg -to $length -i "$radio6" -c copy -metadata title="$(echo $file | sed 's/\..*//')" -metadata date="$(date +%Y)" /home/$colin/Music/$file
len=$(ls -l /home/$colin/Music/$file | awk '{ print $5 }')
  fi
else
  echo nofile /home/$colin/Music/$file
fi
embed_cover "/home/$colin/Music/$file" "${HOME}/Pictures/${cover}"
if  [[ ! " $(hostname -I) " == *" ${trixie64} "* ]]; then
  scp /home/$colin/Music/$file pi@$trixie64:/home/pi/Music
  export MPD_HOST=$trixie64
fi
echo Finish $(date)
#mpc --wait update

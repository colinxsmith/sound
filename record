#!/bin/bash
length=${1:-02\:00\:00}
pi=${2:-pi}
server_place=192.168.0.37
now="$(date +%a-%d_%m_%Y_%T)_$(uname -m -n -s|sed 's/ /-/'g)"
echo $now
filet=recordtr$now.mp3
file=${3:-$filet}
radio6="http://lsn.lv/bbcradio.m3u8?station=bbc_6music&bitrate=320000"
radio1X="http://lsn.lv/bbcradio.m3u8?station=bbc_1xtra&bitrate=320000"
station=${4:-radio6}
station=${station#$}
station=${!station#$}
if [ $(uname -n) != $server_place ]; then
rm /home/$pi/sound/"$file"
fi
if [ $(uname -n) = $server_place ]; then
rm /home/$pi/sound/"$file"
fi
#ffmpeg -i "https://lstn.lv/bbcradio.m3u8?station=bbc_6music&bitrate=9120000" -ab 320k -to $length /home/$pi/sound/"$file"
echo Start $(date)
if [ $(uname -n) != $server_place ]; then
	echo $station
ffmpeg -to $length -i "$station" -ab 320k -id3v2_version 3 -write_id3v1 1 -metadata title="$station" -metadata title="$station at $now" -metadata album="$(uname -a)" -metadata artist="Length: $length" -metadata date="$(date +%Y)" /home/$pi/sound/"$file"
id3v2 -l /home/$pi/sound/"$file"
#cp /home/$pi/sound/"$file" /home/$pi/Music
fi
if [ $(uname -n) = $server_place ]; then
	echo $radio6
ffmpeg -to $length -i "$station" -ab 320k -id3v2_version 3 -write_id3v1 1 -metadata title="$station" -metadata title="$station at $now" -metadata album="$(uname -a)" -metadata artist="Length: $length" -metadata date="$(date +%Y)" /home/$pi/sound/"$file"
id3v2 -l /home/$pi/sound/"$file"
cp /home/$pi/sound/"$file" /home/$pi/Music
fi
echo End $(date)
if [ $(uname -n) != $server_place ]; then
	scp /home/$pi/sound/"$file" pi@$server_place.local:/home/pi/Music
	export MPD_HOST=$server_place.local
fi
mpc --wait update
mpc add "$file"

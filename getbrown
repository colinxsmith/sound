#!/bin/bash

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Arguments: $1 = length in seconds or HH:MM:SS (default 21600), $2 = target name (default wfm1)
length=${1:-21600}
target_name=${2:-wfm1}
target_name=${target_name%.mp3} # Strip .mp3 if the user passed it in

current_user=${USER:-$(whoami)}
user_home=${HOME:-/home/$current_user}
cover=${3:-tower.jpeg}

tim=$(date +%d_%m_%Y_%H-%M-%S)
out_dir="$user_home/sound"
cover="$user_home/Pictures/${cover}"
stream_url="https://worldwide-fm.radiocult.fm/stream"
outfile="$out_dir/Brownswood_Basement_${tim}.mp3"

mkdir -p "$out_dir"

e1=$(date +%s)
echo "Start: $(date --date=@"$e1") (Target duration: ${length})"

# Record stream with auto-reconnect and abort cleanly if ffmpeg fails
if ! ffmpeg -nostdin -loglevel error \
    -reconnect 1 -reconnect_streamed 1 -reconnect_delay_max 10 \
    -i "$stream_url" -i "$cover" \
    -map 0:a -map 1:v -t "$length" \
    -c copy -id3v2_version 3 -disposition:v:0 attached_pic "$outfile"; then
    echo "Error: ffmpeg failed to record stream from $stream_url"
    exit 1
fi

e2=$(date +%s)
echo "End: $(date --date=@"$e2")"
actual_length=$((e2 - e1))

# Apply ID3v2 tags
id3v2 -y "$(date +%Y)" "$outfile"
id3v2 -a "$(date +%a-%d-%B-%Y) Recording" "$outfile"
id3v2 -t "World Wide FM (${actual_length} secs)" "$outfile"
id3v2 -c "$(uname -a)" "$outfile"
id3v2 -A "$target_name on $(date +%a-%H:%M:%S)" "$outfile"

# Atomic copy to Music directory for MPD
cp "$outfile" "$user_home/Music/${target_name}.tmp.mp3"
mv "$user_home/Music/${target_name}.tmp.mp3" "$user_home/Music/${target_name}.mp3"

mpc --wait update

